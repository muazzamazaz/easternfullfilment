{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-zip": "*",
        "amazon-php/sp-api-sdk": "^5.0",
        "automattic/woocommerce": "^3.1",
        "aws/aws-sdk-php": "^3.321",
        "campo/laravel-shipstation": "^5.0",
        "dissolve/ship-station": "^1.5",
        "doctrine/dbal": "^3.0",
        "gladcodes/keygen": "^2.0.0-alpha",
        "guzzlehttp/guzzle": "^7.8",
        "intervention/image": "^2.5",
        "jlevers/selling-partner-api": "^6.0",
        "joedixon/laravel-translation": "^2.2",
        "kwn/number-to-words": "^1.12",
        "laravel/framework": "^10.15.0",
        "laravel/tinker": "^2.8",
        "laravel/ui": "^4.0",
        "laravelcollective/html": "^6.2",
        "league/oauth2-client": "^2.7",
        "maatwebsite/excel": "^3.1.48",
        "milon/barcode": "^10.0",
        "nwidart/laravel-modules": "^8.3",
        "signifly/laravel-shopify": "^1.2",
        "spatie/laravel-permission": "^5.8",
        "srmklive/paypal": "^3.0",
        "stripe/stripe-php": "^7.57",
        "twilio/sdk": "^6.10"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "spatie/laravel-ignition": "^2.0",
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Models\\": "app/Models/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "Modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
